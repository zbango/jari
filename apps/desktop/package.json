{
  "name": "@agent-desktop/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop workspace for observing and coordinating coding agents.",
  "homepage": "https://agent-desktop.invalid",
  "author": "Agent Desktop contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "dev": "install-electron && electron-vite dev --watch",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "html-to-text": "10.0.1",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@agent-desktop/config": "workspace:*",
    "@agent-desktop/shared": "workspace:*",
    "@agent-desktop/ui": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@once-ui-system/core": "3.0.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@tiptap/extensions": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@types/html-to-text": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.3.0",
    "@xyflow/react": "13.0.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "desktopName": "agent-desktop.desktop",
  "productName": "Agent Desktop"
}
