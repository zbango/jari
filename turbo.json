{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json", ".node-version"],
  "globalEnv": ["ELECTRON_RUN_AS_NODE"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ATLASSIAN_INSTANCE_URL",
        "ATLASSIAN_USER_EMAIL",
        "ATLASSIAN_API_TOKEN",
        "JARI_ATLASSIAN_*",
        "JARI_CODEX_BIN",
        "JARI_CLAUDE_BIN",
        "JARI_DEBUG_ENV",
        "CODEX_HOME",
        "ANTHROPIC_*"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CSC_*", "WIN_CSC_*", "APPLE_*"]
    }
  }
}
