# Copy this file to .env at the repository root for local development.
ATLASSIAN_INSTANCE_URL=https://your-site.atlassian.net
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=

# Optional native executable overrides when the tools are outside PATH.
# JARI_CODEX_BIN=
# JARI_CLAUDE_BIN=

# DEV ONLY. Set to 1 to log which variables are configured.
# Turn it back off after troubleshooting.
JARI_DEBUG_ENV=1
